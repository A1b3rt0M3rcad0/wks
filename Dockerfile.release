FROM python:3.12-slim-trixie
ENV PYTHONUNBUFFERED=1 UV_CACHE_DIR=/tmp/uv-cache UV_LINK_MODE=copy
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg tesseract-ocr tesseract-ocr-por tesseract-ocr-eng \
    postgresql-client ca-certificates fonts-dejavu-core espeak-ng \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /usr/local/bin/uv
WORKDIR /app
COPY dist/native-requirements.txt /tmp/native-requirements.txt
RUN --mount=type=secret,id=cloud_ca \
    if [ -s /run/secrets/cloud_ca ]; then export SSL_CERT_FILE=/run/secrets/cloud_ca; fi; \
    uv pip install --system --system-certs --require-hashes -r /tmp/native-requirements.txt
COPY dist/*.whl /tmp/wheels/
RUN --mount=type=secret,id=cloud_ca \
    if [ -s /run/secrets/cloud_ca ]; then export SSL_CERT_FILE=/run/secrets/cloud_ca; fi; \
    uv pip install --system --system-certs --no-deps /tmp/wheels/*.whl \
    && useradd --create-home --uid 10001 wks \
    && mkdir -p /app/.local && chown wks:wks /app/.local
COPY --chown=10001:10001 migrations /app/migrations
COPY --chown=10001:10001 alembic.ini /app/alembic.ini
ARG WKS_VERSION
ARG WKS_COMMIT
ARG WKS_SOURCE
LABEL org.opencontainers.image.version=$WKS_VERSION \
      org.opencontainers.image.revision=$WKS_COMMIT \
      org.opencontainers.image.source=$WKS_SOURCE
USER wks
EXPOSE 8080
CMD ["wks", "api"]
