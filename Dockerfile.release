FROM python:3.12-slim-trixie AS common
ENV PYTHONUNBUFFERED=1 UV_CACHE_DIR=/tmp/uv-cache UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /usr/local/bin/uv
WORKDIR /app
ARG WKS_VERSION
ARG WKS_COMMIT
ARG WKS_SOURCE
LABEL org.opencontainers.image.version=$WKS_VERSION \
      org.opencontainers.image.revision=$WKS_COMMIT \
      org.opencontainers.image.source=$WKS_SOURCE
RUN useradd --create-home --uid 10001 wks && mkdir -p /app/.local && chown wks:wks /app/.local

FROM common AS api
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY dist/api-requirements.txt /tmp/requirements.txt
COPY dist/wks_core-*.whl dist/wks_api-*.whl /tmp/wheels/
RUN --mount=type=secret,id=cloud_ca \
    if [ -s /run/secrets/cloud_ca ]; then export SSL_CERT_FILE=/run/secrets/cloud_ca; fi; \
    uv pip install --system --system-certs --require-hashes -r /tmp/requirements.txt \
    && uv pip install --system --system-certs --no-deps /tmp/wheels/*.whl && rm -rf /tmp/uv-cache /tmp/wheels
COPY --chown=10001:10001 migrations /app/migrations
COPY --chown=10001:10001 alembic.ini /app/alembic.ini
USER wks
EXPOSE 8080
CMD ["wks", "api"]

FROM common AS worker-base
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg tesseract-ocr tesseract-ocr-por tesseract-ocr-eng ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY dist/wks_core-*.whl dist/wks_worker-*.whl /tmp/wheels/

FROM worker-base AS native
COPY dist/native-requirements.txt /tmp/requirements.txt
COPY dist/wks_worker_native-*.whl /tmp/wheels/
RUN --mount=type=secret,id=cloud_ca \
    if [ -s /run/secrets/cloud_ca ]; then export SSL_CERT_FILE=/run/secrets/cloud_ca; fi; \
    uv pip install --system --system-certs --require-hashes -r /tmp/requirements.txt \
    && uv pip install --system --system-certs --no-deps /tmp/wheels/*.whl && rm -rf /tmp/uv-cache /tmp/wheels
USER wks
CMD ["wks-worker-native"]

FROM worker-base AS docling
COPY dist/docling-requirements.txt /tmp/requirements.txt
COPY dist/wks_worker_native-*.whl dist/wks_worker_docling-*.whl /tmp/wheels/
RUN --mount=type=secret,id=cloud_ca \
    if [ -s /run/secrets/cloud_ca ]; then export SSL_CERT_FILE=/run/secrets/cloud_ca; fi; \
    uv pip install --system --system-certs --index-strategy unsafe-best-match --require-hashes -r /tmp/requirements.txt \
    && uv pip install --system --system-certs --no-deps /tmp/wheels/*.whl && rm -rf /tmp/uv-cache /tmp/wheels
ENV HF_HUB_OFFLINE=1 OMP_NUM_THREADS=2
USER wks
CMD ["wks-worker-docling"]

FROM worker-base AS media
COPY dist/media-requirements.txt /tmp/requirements.txt
COPY dist/wks_worker_media-*.whl /tmp/wheels/
RUN --mount=type=secret,id=cloud_ca \
    if [ -s /run/secrets/cloud_ca ]; then export SSL_CERT_FILE=/run/secrets/cloud_ca; fi; \
    uv pip install --system --system-certs --require-hashes -r /tmp/requirements.txt \
    && uv pip install --system --system-certs --no-deps /tmp/wheels/*.whl && rm -rf /tmp/uv-cache /tmp/wheels
ENV HF_HUB_OFFLINE=1 OMP_NUM_THREADS=2
USER wks
CMD ["wks-worker-media"]
