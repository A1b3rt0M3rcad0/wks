FROM python:3.12-slim-trixie AS base
ENV PYTHONUNBUFFERED=1 UV_CACHE_DIR=/tmp/uv-cache UV_LINK_MODE=copy
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg tesseract-ocr tesseract-ocr-por tesseract-ocr-eng \
    postgresql-client ca-certificates fonts-dejavu-core espeak-ng \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
ARG WKS_BUILD_EXTRAS=""
RUN --mount=type=secret,id=cloud_ca \
    if [ -s /run/secrets/cloud_ca ]; then export SSL_CERT_FILE=/run/secrets/cloud_ca; fi; \
    uv sync --system-certs --frozen --no-dev --no-install-project $WKS_BUILD_EXTRAS
COPY . .
RUN --mount=type=secret,id=cloud_ca \
    if [ -s /run/secrets/cloud_ca ]; then export SSL_CERT_FILE=/run/secrets/cloud_ca; fi; \
    uv sync --system-certs --frozen --no-dev $WKS_BUILD_EXTRAS && useradd --create-home --uid 10001 wks \
    && mkdir -p /app/.local && chown wks:wks /app/.local
ENV PATH="/app/.venv/bin:$PATH"
USER wks
EXPOSE 8080
CMD ["wks", "api"]

FROM base AS test
USER root
COPY tests ./tests
COPY scripts ./scripts
RUN --mount=type=secret,id=cloud_ca \
    if [ -s /run/secrets/cloud_ca ]; then export SSL_CERT_FILE=/run/secrets/cloud_ca; fi; \
    uv sync --system-certs --frozen --group dev $WKS_BUILD_EXTRAS
ENV PYTEST_ADDOPTS="-o cache_dir=/tmp/wks-pytest-cache"
USER wks
CMD ["pytest", "-q"]
