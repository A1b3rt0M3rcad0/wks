# Local development only. Real production credentials must be supplied securely.
WKS_ENV=development
WKS_DATABASE_URL=postgresql+psycopg://wks:wks-local@127.0.0.1:55432/wks
WKS_STORAGE_PROVIDER=filesystem
WKS_STORAGE_PATH=.local/objects
WKS_HTTP_HOST=127.0.0.1
WKS_HTTP_PORT=8080
WKS_UPLOAD_MAX_BYTES=67108864
WKS_NAMESPACE_MAX_BYTES=1073741824
WKS_PROCESS_MAX_PAGES=200
WKS_PROCESSING_TIMEOUT_SECONDS=300
WKS_JOB_LEASE_SECONDS=360
WKS_JOB_MAX_ATTEMPTS=3
WKS_SEARCH_MAX_PAGE_SIZE=50
WKS_SEARCH_MAX_RESPONSE_CHARS=16000
WKS_OCR_ENABLED=true
WKS_OCR_LANGUAGE=por+eng
WKS_EXTRACTION_PROFILE=native
WKS_ASR_ENABLED=false
# WKS_ASR_MODEL_PATH=/path/to/verified/local/faster-whisper-model
WKS_VIDEO_ENABLED=false
WKS_VIDEO_MAX_SECONDS=120
WKS_VIDEO_MAX_FRAMES=8
WKS_WEB_CAPTURE_ENABLED=false
WKS_ENRICHMENT_PROVIDER=none
WKS_MCP_ENABLED=true
# Production: use a strong secret from the secret manager.
# WKS_CURSOR_SECRET=
# S3: boto3 uses the standard credentials chain; never store keys in source control.
# WKS_S3_BUCKET=wks-content
# WKS_S3_ENDPOINT=https://s3.example.com
# WKS_S3_REGION=us-east-1

# Browser workspace: set canonical HTTPS origin in production.
# WKS_WEB_PUBLIC_ORIGIN=https://wks.example.com
WKS_WEB_SESSION_TTL_SECONDS=28800
# Compose can run the immutable published image without building locally:
# WKS_IMAGE=ghcr.io/a1b3rt0m3rcad0/wks:0.2.0
